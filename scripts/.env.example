# Copy to scripts/.env (gitignored). Values from the Cloudflare dashboard:
# Account ID: dashboard home → right sidebar. R2 keys: R2 → Manage API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=family-gallery
# Same value you set with: wrangler secret put ADMIN_TOKEN
ADMIN_TOKEN=
# Where to register metadata. Production site, or http://localhost:8787 during local dev.
API_BASE=https://pulkit-sinha.com
